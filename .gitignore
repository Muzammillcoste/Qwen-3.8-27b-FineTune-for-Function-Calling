.sf/
.sfdx/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv*/
venv/
env/
.python-version

# ---------------------------------------------------------------- tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ipynb_checkpoints/
.cache/
**/.cache/

# ---------------------------------------------------------------- secrets (never commit tokens)
.env
.env.*
*.token
.huggingface/
kaggle.json

# ---------------------------------------------------------------- data
# Never commit source or derived xLAM data (gated, CC BY 4.0 with access conditions).
# Directory skeleton is kept via .gitkeep files only.
data/**
!data/**/
!data/**/.gitkeep

# ---------------------------------------------------------------- models / training outputs
artifacts/**
!artifacts/.gitkeep
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
checkpoint-*/
wandb/
runs/
mlruns/
outputs/
*.log

# Run outputs: Kaggle output zips, extracted predictions (contain xLAM text), adapters,
# checkpoints. Lightweight AGGREGATE metrics + ID manifests live in reports/ (version-controlled).
results/**
!results/**/
!results/**/.gitkeep
*.zip
**/pilot_adapter/
**/adapters/
**/predictions_*.jsonl
**/extracted/

# Benchmark data (BFCL etc.) is downloaded/extracted locally, never committed
benchmark_data/
**/BFCL_*.json
**/possible_answer/

# ---------------------------------------------------------------- OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
